# Build config của web-admin (SPA). VITE_* là build-time config: nhúng vào bundle, đổi giá trị phải build lại.
# Cấu hình theo môi trường đặt ở runtime (APP_ENV → /config.json) để image dùng chung được.
DOCKERFILE=web-static
CONTEXT=source
BUILD_ARG_BASE_IMAGE=node:26-slim
BUILD_ARG_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
